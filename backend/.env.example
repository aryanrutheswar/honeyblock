# OpenRouter API Key (Optional - free models supported)
# Sign up at https://openrouter.ai to get a free API key
OPENROUTER_API_KEY=

# Default free-tier model (e.g., meta-llama/llama-3.1-8b-instruct:free, google/gemini-2.0-flash-exp:free)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Server Port
PORT=5000
